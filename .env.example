# LangLink - variables d'environnement
# Copier en `.env` puis remplacer toutes les valeurs `change-me-*`.
# `.env` n'est jamais commite (cf. .gitignore).

# --- Application
ENV=dev
PUBLIC_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173

# --- Base de donnees
POSTGRES_DB=langlink
POSTGRES_USER=langlink
POSTGRES_PASSWORD=change-me-in-production
DATABASE_URL=postgresql+psycopg://langlink:langlink@db:5432/langlink

# --- Securite
JWT_SECRET=change-me-at-least-32-characters-long
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# --- Medias
MEDIA_ROOT=/data/uploads
MEDIA_MAX_BYTES=5242880

# --- Produit
DISCOVERY_DAILY_QUOTA=20
REWIND_COOLDOWN_SECONDS=3600
MESSAGE_MAX_LENGTH=4000

# --- Traduction (profil compose translation)
LIBRETRANSLATE_URL=http://libretranslate:5000
LIBRETRANSLATE_TIMEOUT_SECONDS=5
LT_LOAD_ONLY=en,fr,es,de,ja

# DEEPL_API_KEY=
